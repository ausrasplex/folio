# Copy this file to .env and fill it in. Never commit your .env.

# The Postgres database Folio uses.
DATABASE_URL="postgresql://folio:pick-a-password@localhost:5432/folio?schema=public"

# 32+ random characters. Encrypts account numbers and two-step secrets. Keep it safe: without it they cannot be read.
# Make one in a terminal (prints 44 random characters; paste it between the quotes below):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or, on macOS and Linux:  openssl rand -base64 32
FOLIO_SECRET=""

# Optional
# The address people use to reach Folio, used in alert links and invite links (for example http://folio.home.lan:3000)
# FOLIO_URL=""
# Where backups are written when the Server tab has not set a folder (relative to where Folio runs)
# FOLIO_BACKUP_DIR="./backups"
# A JSON address that answers {"version": "x.y.z"}, for the Check for updates button
# FOLIO_UPDATE_URL=""
# The largest backup file the admin can restore, in MB (2048 when not set)
# FOLIO_MAX_RESTORE_MB=""
# Set to 1 to turn off automatic backups and alert sending (for example while testing)
# FOLIO_NO_JOBS=""
# The sign-in cookie is Secure (HTTPS only, named __Host-folio_session) whenever Folio is reached over HTTPS: FOLIO_URL starts
# with https://, or a trusted proxy (FOLIO_TRUST_PROXY) says the request was HTTPS. Set to false to always use a plain cookie,
# for example when people also open Folio over plain HTTP on the home network. Set to true to always make it Secure.
# FOLIO_SECURE_COOKIE=""

# Behind a reverse proxy or Cloudflare (leave these off when people reach Folio directly)
# Set to true only when every request reaches Folio through your own proxy. Folio then reads the visitor's address from
# cf-connecting-ip or x-forwarded-for. Left off, those headers are ignored, because anyone can send them.
# FOLIO_TRUST_PROXY=""
# Addresses of proxies in front of that one, comma-separated (only needed when there are two in a row)
# FOLIO_TRUSTED_PROXY_IPS=""

# Build only: set to 1 to build the standalone server used by the Docker image
# FOLIO_STANDALONE=""
